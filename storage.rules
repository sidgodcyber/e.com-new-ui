rules_version = '2';

// 7 Cheese Pizza — menu and banner photos.
// Paste into Firebase console → Storage → Rules → Publish.
// Everyone can see the photos; only the owner login can upload, replace or delete them.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.role == 'owner' &&
        firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner() && request.resource.size < 6 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isOwner();
    }
  }
}
